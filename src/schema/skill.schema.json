{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 100,
      "description": "Human-readable name of the skill"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Brief description of what the skill does"
    },
    "domain": {
      "type": "string",
      "description": "Domain or category (e.g., 'infrastructure', 'content')"
    },
    "confidence": {
      "enum": ["low", "medium", "high"],
      "description": "Confidence level in the skill's reliability"
    },
    "source": {
      "type": "string",
      "description": "Source of the skill (e.g., 'user', 'generated', 'copilot')"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Phrases that should trigger this skill"
    },
    "category": {
      "type": "string",
      "description": "Sub-category within the domain"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for classification and search"
    },
    "status": {
      "enum": ["experimental", "active", "deprecated"],
      "description": "Current status of the skill"
    },
    "tools": {
      "type": "array",
      "description": "Tools required or used by this skill"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other skills or resources this depends on"
    }
  }
}
